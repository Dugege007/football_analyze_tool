# =============================================================================
# football_analyze_tool · 本地配置样例
# 用法：复制本文件为仓库根目录的 .env（cp config.example.env .env），再按需填写。
#   - .env 已在 .gitignore 中，永远不要提交。
#   - 本文件只放占位值（YOUR_...），不含任何真实 key。
#   - 各 Python 入口启动时会自动读取仓库根 .env（已存在的系统环境变量优先，不会被覆盖）；
#     也可在 shell 中 `set -a; . ./.env; set +a` 手动导入。
#   - 路径类变量：可写绝对路径；相对路径的解析基准见各条说明。
# 各数据源如何申请、权限建议、如何验证，见 docs/SENSITIVE.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、本地 API（api/，FastAPI）
# -----------------------------------------------------------------------------

# APP_DB_PATH
#   用途：API 读取的 SQLite 主库路径；采集脚本也用它识别「现网库」并拒绝写入它。
#   来源：你自己的库。可指向自己电脑上每日备份出来的 .db（例如 D:/football/backups/app_2026-10-09.db）。
#   必填：否。默认 api/data/app.db（不存在时可用 api/scripts/seed.py 生成演示库）。
#   相对路径按 api/ 目录解析。用于：uvicorn 启动、api/scripts/* 读写库。
APP_DB_PATH=data/app.db

# APP_DB_LABEL
#   用途：响应 meta.db 标签，只能是 live 或 v2d3。v2d3 表示「研究副本」，此时必须 APP_READONLY=1。
#   必填：否。默认 live。
APP_DB_LABEL=live

# APP_READONLY
#   用途：1 = 只读实例（SQLite 以 mode=ro 打开，所有 POST/PUT/PATCH/DELETE 返回 403）。
#   建议：APP_DB_PATH 指向你的备份库时设为 1，避免误写。
#   必填：否。默认 0。
APP_READONLY=1

# APP_CORS_ORIGINS
#   用途：跨源资源共享（Cross-Origin Resource Sharing，简称 CORS）允许访问接口的网页来源，多个来源用英文逗号分隔。
#   默认：http://127.0.0.1:5173,http://localhost:5173（本机网页界面开发服务器）。
#   说明：网页界面开发服务器默认通过代理访问接口，一般不需要修改；只有让浏览器直接跨端口访问接口时才需要加上对应来源。
#   填写 * 表示允许任意来源（此时不允许携带凭据）。必填：否。
# APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# DUAL_WRITE_ODDS_ASIAN
#   用途：现网库 odds_asian 双写开关。公开版默认关（0）；为 1 时采集入库脚本会直接拒绝运行。
#   必填：否。默认 0。除非你完全理解 docs/schema/v2_0-d2-dual-write-plan.md，请保持 0。
DUAL_WRITE_ODDS_ASIAN=0

# DUAL_WRITE
#   用途：个别迁移脚本（api/scripts/migrate_leak_suspect_live.py）的通用双写保护开关。
#   必填：否。默认 0。
DUAL_WRITE=0

# -----------------------------------------------------------------------------
# 二、目录与库路径（采集/补数脚本）
# -----------------------------------------------------------------------------

# MA_API_ROOT
#   用途：后端代码目录（scripts/ 下脚本 import api/app 的同一套函数）。
#   必填：否。默认 <仓库根>/api；一般不用改。相对路径按仓库根解析。
# MA_API_ROOT=api

# ODDS_DATA_DIR
#   用途：采集/补数的运行时数据目录（原始 JSON、staging、plan/state、日志、rescue_queue 等）。
#   必填：否。默认 <仓库根>/data/odds-data（已被 .gitignore 排除）。相对路径按仓库根解析。
#   建议放在仓库外的大容量盘，例如 D:/football/odds-data 或 ~/football/odds-data。
ODDS_DATA_DIR=data/odds-data

# V2D3_DB_PATH
#   用途：研究副本库（live_capture / asof_backfill / rescue_* 只往这里写，从不写 APP_DB_PATH）。
#   来源：可把自己的备份 .db 复制一份专门当副本（不要与 APP_DB_PATH 同一个文件）。
#   必填：否。默认 api/data/v2d3/app.db。相对路径按 api/ 目录解析。
V2D3_DB_PATH=data/v2d3/app.db

# BACKUP_DIR
#   用途：api/scripts/backup_daily.py 的每日备份输出目录。
#   必填：否。默认 <仓库根>/backups/football（已被 .gitignore 排除）。
# BACKUP_DIR=backups/football

# LIVE_CAPTURE_PYTHON
#   用途：live_capture.py ensure-daemon 拉起常驻进程时使用的 Python 解释器。
#   必填：否。默认当前解释器（sys.executable）。
# LIVE_CAPTURE_PYTHON=/path/to/venv/bin/python

# LIVE_CAPTURE_CREATE_MATCHES
#   用途：副本缺场次时是否按 5DF 场次清单补建 stub 行。
#   必填：否。默认 0（不补建）。
LIVE_CAPTURE_CREATE_MATCHES=0

# SHARED_API_YIELD_LEDGER / SHARED_API_YIELD_LOG
#   用途：补数队列与实时采集共用同一个 5DF key 时的「让路」台账与日志文件。
#   必填：否。默认 $ODDS_DATA_DIR/5dollar/backfill_yield_ledger.json 与 backfill_yield.jsonl。
# SHARED_API_YIELD_LEDGER=data/odds-data/5dollar/backfill_yield_ledger.json
# SHARED_API_YIELD_LOG=data/odds-data/5dollar/backfill_yield.jsonl

# CONFIRM_FULL_RUN
#   用途：scripts/backfill/5df-multibook-history-queue/run_queue.py 不带 --limit 全量跑时的二次确认。
#   必填：否。默认不设（拒绝全量跑）。
# CONFIRM_FULL_RUN=1

# -----------------------------------------------------------------------------
# 三、数据源 API Key（全部自备；只放本机 .env，永不提交）
# -----------------------------------------------------------------------------

# FIVEDOLLAR_FOOTBALL_API_KEY  —— 5DollarFootballAPI（5DF）
#   用途：实时采集（scripts/live/live_capture.py）、as-of 补中盘、漏点补救、多公司历史补数。
#   申请：https://5dollarfootballapi.com 注册并订阅。
#   必填：跑 live 采集/补数时必填；只跑 API 健康检查、check-config 时可留空。
#   默认：无。鉴权方式 Authorization: Bearer <key>。
FIVEDOLLAR_FOOTBALL_API_KEY=YOUR_5DF_API_KEY

# INFERSPORTS_API_KEY  —— InferSports
#   用途：scripts/backfill/infersports_daily.py 每日补数。
#   申请：https://infersports.dev 注册获取。
#   必填：仅跑该脚本时必填。默认：无。鉴权 Authorization: Bearer <key>。
INFERSPORTS_API_KEY=YOUR_INFERSPORTS_API_KEY

# API_FOOTBALL_KEY  —— API-Football（api-sports.io）
#   用途：scripts/backfill/apifootball_daily.py 每日补数。
#   申请：https://dashboard.api-football.com 注册。
#   必填：仅跑该脚本时必填。默认：无。鉴权请求头 x-apisports-key。
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

# BSD_BZZOIRO_API_KEY  —— BSD（Bzzoiro Sports Data，xG / 伤停探针）
#   用途：v0 代码未直接调用；docs/schema 中 xG/基本面方案的数据源，后续版本接入。
#   申请：https://sports.bzzoiro.com 注册获取。必填：否。鉴权 Authorization: Token <key>。
# BSD_BZZOIRO_API_KEY=YOUR_BSD_API_KEY

# FOOTBALL_DATA_ORG_API_KEY  —— football-data.org
#   用途：v0 代码未直接调用（赛程/赛果备用源调研）。
#   申请：https://www.football-data.org/client/register 。必填：否。鉴权请求头 X-Auth-Token。
# FOOTBALL_DATA_ORG_API_KEY=YOUR_FOOTBALL_DATA_ORG_KEY

# ODDSPAPI_API_KEY  —— OddsPapi
#   用途：v0 代码未直接调用（赔率备用源调研）。申请：https://oddspapi.io 。必填：否。query 参数 apiKey。
# ODDSPAPI_API_KEY=YOUR_ODDSPAPI_KEY

# THE_ODDS_API_KEY  —— The Odds API
#   用途：v0 代码未直接调用（赔率备用源调研）。申请：https://the-odds-api.com 。必填：否。query 参数 apiKey。
# THE_ODDS_API_KEY=YOUR_THE_ODDS_API_KEY

# THE_STATS_API_KEY  —— TheStatsAPI
#   用途：v0 代码未直接调用（统计数据源调研）。申请：https://thestatsapi.com 。必填：否。Authorization: Bearer <key>。
# THE_STATS_API_KEY=YOUR_THE_STATS_API_KEY

# football-data.co.uk：免费 CSV 直链，无需 key（scripts/backfill/football_data_2627_merge.py）。
# 竞彩官网（sporttery.cn）：无 key；需要能访问竞彩官网的网络环境，v0 不含采集代码，见 docs/SENSITIVE.md。

# ===================== 策略参数与测试 =====================
# STRATEGY_PARAMS_PATH —— 策略参数文件路径（可选）
#   用途：影子预测、Dixon-Coles 模型用到的调参数值。公开仓不提供真实数值。
#   默认依次查找 config/strategy_params.json → config/strategy_params.example.json（全为 null）。
#   参数为 null 时，用到它的策略会报 StrategyParamsMissing，不会用默认值偷偷跑。见 docs/STRATEGY_PARAMS.md。
# STRATEGY_PARAMS_PATH=config/strategy_params.json

# FAT_DISABLE_DOTENV —— 设为 1 时不自动读取仓库根目录的 .env（可选）
#   用途：测试或 CI 中避免本机 .env 影响结果；pytest 的 conftest 会自动设为 1。平时不用设。
# FAT_DISABLE_DOTENV=1
